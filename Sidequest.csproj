<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms is enabled solely for NotifyIcon, which WPF does not provide.
         Both namespaces define Application/MessageBox, so code files alias them. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Sidequest</RootNamespace>
    <AssemblyName>Sidequest</AssemblyName>
    <!-- 5.8 shows this in the Settings footer as "Sidequest 0.1". -->
    <Version>0.4.0</Version>
    <!-- The exe's icon, drawn from the tray's mark by tools/make-icon.ps1. Conditional so
         a checkout without it still builds, and the script can draw it again. -->
    <ApplicationIcon Condition="Exists('Sidequest.ico')">Sidequest.ico</ApplicationIcon>
    <!-- This project lives at the repo root, so its default globs would otherwise
         compile the test project's sources into the app as well. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded so the app carries its own type and needs nothing installed. -->
    <Resource Include="Fonts\*.ttf"/>
    <!-- The OFL requires the licence to travel with the fonts. -->
    <None Include="Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

</Project>
