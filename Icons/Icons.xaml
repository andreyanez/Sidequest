<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Geometry transcribed from the reference artboards in docs/design/reference/,
         which carry the authoritative shapes. Every icon is drawn in a 16x16 box and
         stroked, never filled, per 4.3: 1.5px, round caps and joins, Text2 at rest.

         SVG <circle> and <rect> are rewritten as arcs and closed subpaths, and SVG's
         compressed arc flags ("a3.5 3.5 0 010 7") are expanded, because WPF's path
         mini-language does not accept them.

         Colour is never baked in - IconPath takes its Stroke from the ambient
         Foreground, so an icon follows the theme and its hover state for free. -->

    <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Stretch" Value="None"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="SnapsToDevicePixels" Value="False"/>
        <Setter Property="Stroke" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
    </Style>

    <!-- The one exception to "stroked, never filled": FnSidequest draws "⋯" as three
         solid dots (fill="currentColor", no stroke). Stroking the same circles would
         turn them into rings. -->
    <Style x:Key="IconPath.Filled" TargetType="Path" BasedOn="{StaticResource IconPath}">
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="Fill" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
    </Style>

