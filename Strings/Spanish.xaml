<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Cada clave de aquí debe existir también en English.xaml (ResourceParityTests lo
         comprueba). Desde XAML se usan con DynamicResource y desde código con
         LanguageService.Get / Format. Las claves que terminan en Fmt llevan {0}.

         Son las claves de la 7, añadidas a medida que llega cada pantalla; las pocas que no
         están en la 7 van al final, marcadas. -->

    <!-- Comunes y barra de título -->
    <sys:String x:Key="L_AppName">Sidequest</sys:String>
    <sys:String x:Key="L_Back">Volver</sys:String>
    <sys:String x:Key="L_MainPanel">Panel principal</sys:String>
    <sys:String x:Key="L_Sidequests">Sidequests</sys:String>
    <sys:String x:Key="L_CounterFmt">{0} / {1}</sys:String>
    <sys:String x:Key="L_Collapse">Contraer</sys:String>
    <sys:String x:Key="L_Expand">Expandir</sys:String>
    <sys:String x:Key="L_KeepOnTop">Mantener encima de otras apps</sys:String>
    <sys:String x:Key="L_Close">Cerrar</sys:String>
    <sys:String x:Key="L_Cancel">Cancelar</sys:String>
    <sys:String x:Key="L_Settings">Ajustes</sys:String>

    <!-- Panel principal (5.1) -->
    <sys:String x:Key="L_PanelEmpty">Sin objetivos. Entra a un Sidequest y envía uno.</sys:String>
    <sys:String x:Key="L_ReturnToSidequest">Devolver al Sidequest</sys:String>
    <sys:String x:Key="L_DeleteObjective">Eliminar objetivo</sys:String>
    <sys:String x:Key="L_DeleteObjectiveQ">¿Eliminar este objetivo? También se borra de su Sidequest.</sys:String>

    <!-- Lista y nuevo Sidequest (5.4, 5.5) -->
    <sys:String x:Key="L_ActiveFmt">{0} activos</sys:String>
    <sys:String x:Key="L_NewSidequest">Nuevo Sidequest</sys:String>
    <sys:String x:Key="L_Name">Nombre</sys:String>
    <sys:String x:Key="L_Theme">Tema</sys:String>
    <sys:String x:Key="L_Create">Crear</sys:String>
    <sys:String x:Key="L_Theme_Amber">Ámbar</sys:String>
    <sys:String x:Key="L_Theme_Teal">Turquesa</sys:String>
    <sys:String x:Key="L_Theme_Indigo">Índigo</sys:String>
    <sys:String x:Key="L_Theme_Coral">Coral</sys:String>
    <sys:String x:Key="L_Theme_Olive">Oliva</sys:String>
    <sys:String x:Key="L_Theme_Plum">Ciruela</sys:String>
    <sys:String x:Key="L_Theme_Steel">Acero</sys:String>
    <sys:String x:Key="L_Theme_Slate">Grafito</sys:String>

    <!-- Detalle del Sidequest (5.6) -->
    <sys:String x:Key="L_ItemsFmt">{0} / {1} items</sys:String>
    <sys:String x:Key="L_CurrentObjective">Objetivo actual</sys:String>
    <sys:String x:Key="L_SendObjective">Enviar objetivo</sys:String>
    <sys:String x:Key="L_AddItem">Añadir item</sys:String>
    <sys:String x:Key="L_DeleteItem">Eliminar item</sys:String>
    <sys:String x:Key="L_MoreOptions">Más opciones</sys:String>
    <sys:String x:Key="L_Rename">Renombrar</sys:String>
    <sys:String x:Key="L_ChangeTheme">Cambiar tema</sys:String>
    <sys:String x:Key="L_DeleteSidequest">Eliminar Sidequest</sys:String>
    <!-- La 7 añade "y su Bitácora": vuelve con la v1.1, que es cuando existe. -->
    <sys:String x:Key="L_DeleteSidequestQ">¿Eliminar "{0}" con sus {1} items?</sys:String>

    <!-- Detalle del objetivo (5.3) -->
    <sys:String x:Key="L_NotesAndLinks">Notas y enlaces</sys:String>
    <sys:String x:Key="L_LocalFiles">Archivos locales</sys:String>
    <sys:String x:Key="L_LinkFile">Vincular archivo</sys:String>
    <sys:String x:Key="L_UnlinkFile">Desvincular archivo</sys:String>
    <sys:String x:Key="L_FileMissing">No se encuentra el archivo</sys:String>
    <sys:String x:Key="L_Images">Imágenes</sys:String>
    <sys:String x:Key="L_AddImage">Añadir imagen</sys:String>
    <sys:String x:Key="L_RemoveImage">Quitar imagen</sys:String>

    <!-- Bandeja (5.9). "Ajustes…" llega con la ventana de ajustes en la fase 5. -->
    <sys:String x:Key="L_TrayShow">Mostrar panel</sys:String>
    <sys:String x:Key="L_TraySidequests">Sidequests…</sys:String>
    <sys:String x:Key="L_TrayResetPosition">Restablecer posición</sys:String>
    <sys:String x:Key="L_TrayQuit">Salir</sys:String>

    <!-- Migración (D3) -->
    <sys:String x:Key="L_ImportedSidequest">Importados</sys:String>

    <!-- No están en la 7: el título de la ventana de confirmación, los singulares y la
         pregunta de borrar un item. -->
    <sys:String x:Key="L_ConfirmTitle">Confirmar</sys:String>
    <sys:String x:Key="L_ActiveOneFmt">{0} activo</sys:String>
    <sys:String x:Key="L_DeleteItemQ">¿Eliminar este item?</sys:String>
    <sys:String x:Key="L_DeleteSidequestOneQ">¿Eliminar "{0}" con su único item?</sys:String>
    <sys:String x:Key="L_DeleteSidequestEmptyQ">¿Eliminar "{0}"?</sys:String>
    <!-- El nombre de una miniatura para un lector de pantalla. -->
    <sys:String x:Key="L_ImageFmt">Imagen {0}</sys:String>

</ResourceDictionary>
