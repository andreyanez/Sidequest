<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Every key here must also exist in Spanish.xaml. Referenced from XAML with
         DynamicResource and from code through LanguageService.Get / Format.
         Keys ending in Fmt take {0}-style placeholders. -->

    <!-- Popup -->
    <sys:String x:Key="L_ThisWeek">This week</sys:String>
    <sys:String x:Key="L_PopupEmpty">Nothing on the list yet.</sys:String>
    <sys:String x:Key="L_AddSomeItems">Add some items</sys:String>
    <sys:String x:Key="L_Collapse">Collapse</sys:String>
    <sys:String x:Key="L_Expand">Expand</sys:String>
    <sys:String x:Key="L_Dismiss">Dismiss</sys:String>
    <sys:String x:Key="L_Edit">Edit</sys:String>
    <sys:String x:Key="L_DoneCountFmt">{0} of {1} done</sys:String>
    <sys:String x:Key="L_NothingOnList">Nothing on the list</sys:String>
    <sys:String x:Key="L_SnoozeFmt">Snooze {0}m</sys:String>
    <sys:String x:Key="L_ClosesInFmt">Closes in {0}s</sys:String>

    <!-- Editor -->
    <sys:String x:Key="L_ThisWeeksList">This week's list</sys:String>
    <sys:String x:Key="L_Add">Add</sys:String>
    <sys:String x:Key="L_DoneTooltip">Done</sys:String>
    <sys:String x:Key="L_Weekly">Weekly</sys:String>
    <sys:String x:Key="L_WeeklyTooltip">Carry this over to next week instead of clearing it</sys:String>
    <sys:String x:Key="L_DragToReorder">Drag to reorder</sys:String>
    <sys:String x:Key="L_Remove">Remove</sys:String>
    <sys:String x:Key="L_EditorEmpty">No items yet — add the first one above.</sys:String>
    <sys:String x:Key="L_ClearCompleted">Clear completed</sys:String>
    <sys:String x:Key="L_DragHint">Drag ⋮⋮ to reorder</sys:String>
    <sys:String x:Key="L_PopupTimes">Popup times…</sys:String>
    <sys:String x:Key="L_Done">Done</sys:String>

    <!-- Confirmation -->
    <sys:String x:Key="L_ConfirmTitle">Confirm</sys:String>
    <sys:String x:Key="L_Cancel">Cancel</sys:String>
    <sys:String x:Key="L_RemoveItemQ">Remove this item?</sys:String>
    <sys:String x:Key="L_RemoveRepeatsNote">This one repeats weekly, so removing it stops it coming back.</sys:String>
    <sys:String x:Key="L_RemoveCompletedOneQ">Remove the completed item?</sys:String>
    <sys:String x:Key="L_RemoveCompletedManyQFmt">Remove {0} completed items?</sys:String>
    <sys:String x:Key="L_RemoveAll">Remove all</sys:String>

    <!-- Settings -->
    <sys:String x:Key="L_SettingsTitle">Weekly Reminder — Settings</sys:String>
    <sys:String x:Key="L_Settings">Settings</sys:String>
    <sys:String x:Key="L_WhenItPopsUp">When it pops up</sys:String>
    <sys:String x:Key="L_TimesHelp">At least two a day. Add as many as you like.</sys:String>
    <sys:String x:Key="L_AddTime">Add time</sys:String>
    <sys:String x:Key="L_TimeHintDefault">Type a time like 09:00 and press Enter.</sys:String>
    <sys:String x:Key="L_TimeUnreadableFmt">Couldn't read "{0}" as a time. Try 09:00 or 7:30 pm.</sys:String>
    <sys:String x:Key="L_TimeDuplicateFmt">{0} is already in the list.</sys:String>
    <sys:String x:Key="L_TimeAddedFmt">Added {0}.</sys:String>
    <sys:String x:Key="L_TimeRemovedFmt">Removed {0}.</sys:String>
    <sys:String x:Key="L_TimeMinimumFmt">At least {0} popup times a day are required.</sys:String>
    <sys:String x:Key="L_OnWhichDays">On which days</sys:String>
    <sys:String x:Key="L_DaysHint">Keep at least one day selected.</sys:String>
    <sys:String x:Key="L_Behaviour">Behaviour</sys:String>
    <sys:String x:Key="L_SnoozeFor">Snooze for</sys:String>
    <sys:String x:Key="L_ClosePopupAfter">Close popup after</sys:String>
    <sys:String x:Key="L_KeepOnTop">Keep on top of other windows</sys:String>
    <sys:String x:Key="L_KeepOnTopHelp">Off lets the reminder sit behind whatever you are working in.</sys:String>
    <sys:String x:Key="L_Appearance">Appearance</sys:String>
    <sys:String x:Key="L_DarkMode">Dark mode</sys:String>
    <sys:String x:Key="L_DarkModeHelp">Applies straight away, to every window.</sys:String>
    <sys:String x:Key="L_Language">Language</sys:String>
    <sys:String x:Key="L_Startup">Startup</sys:String>
    <sys:String x:Key="L_OpenOnStartup">Open on startup</sys:String>
    <sys:String x:Key="L_StartupHelp">Adds a per-user entry under the Run key. No admin rights needed.</sys:String>
    <sys:String x:Key="L_PreviewPopup">Preview popup</sys:String>

    <!-- Duration choices -->
    <sys:String x:Key="L_MinutesFmt">{0} minutes</sys:String>
    <sys:String x:Key="L_OneHour">1 hour</sys:String>
    <sys:String x:Key="L_Never">Never</sys:String>
    <sys:String x:Key="L_SecondsFmt">{0} seconds</sys:String>
    <sys:String x:Key="L_OneMinute">1 minute</sys:String>
    <sys:String x:Key="L_TwoMinutes">2 minutes</sys:String>

    <!-- Tray menu -->
    <sys:String x:Key="L_TrayShow">Show reminders</sys:String>
    <sys:String x:Key="L_TrayEdit">Edit this week…</sys:String>
    <sys:String x:Key="L_TraySettings">Settings…</sys:String>
    <sys:String x:Key="L_TrayResetPosition">Reset popup position</sys:String>
    <sys:String x:Key="L_TrayQuit">Quit</sys:String>

</ResourceDictionary>
