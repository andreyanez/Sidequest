<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Every key here must also exist in Spanish.xaml (ResourceParityTests checks).
         Referenced from XAML with DynamicResource and from code through
         LanguageService.Get / Format. Keys ending in Fmt take {0}-style placeholders.

         These are 7's keys, added as each screen lands; the few that 7 does not have are
         at the end, marked. -->

    <!-- Shared and title bar -->
    <sys:String x:Key="L_AppName">Sidequest</sys:String>
    <sys:String x:Key="L_Back">Back</sys:String>
    <sys:String x:Key="L_MainPanel">Main panel</sys:String>
    <sys:String x:Key="L_Sidequests">Sidequests</sys:String>
    <sys:String x:Key="L_CounterFmt">{0} / {1}</sys:String>
    <sys:String x:Key="L_Collapse">Collapse</sys:String>
    <sys:String x:Key="L_Expand">Expand</sys:String>
    <sys:String x:Key="L_KeepOnTop">Keep above other apps</sys:String>
    <sys:String x:Key="L_Close">Close</sys:String>
    <sys:String x:Key="L_Cancel">Cancel</sys:String>
    <sys:String x:Key="L_Settings">Settings</sys:String>

    <!-- Main panel (5.1) -->
    <sys:String x:Key="L_PanelEmpty">No objectives yet. Open a Sidequest and send one.</sys:String>
    <sys:String x:Key="L_ReturnToSidequest">Return to Sidequest</sys:String>
    <sys:String x:Key="L_DeleteObjective">Delete objective</sys:String>
    <sys:String x:Key="L_DeleteObjectiveQ">Delete this objective? It is removed from its Sidequest too.</sys:String>

    <!-- The list and a new Sidequest (5.4, 5.5) -->
    <sys:String x:Key="L_ActiveFmt">{0} active</sys:String>
    <sys:String x:Key="L_NewSidequest">New Sidequest</sys:String>
    <sys:String x:Key="L_Name">Name</sys:String>
    <sys:String x:Key="L_Theme">Theme</sys:String>
    <sys:String x:Key="L_Create">Create</sys:String>
    <sys:String x:Key="L_Theme_Amber">Amber</sys:String>
    <sys:String x:Key="L_Theme_Teal">Teal</sys:String>
    <sys:String x:Key="L_Theme_Indigo">Indigo</sys:String>
    <sys:String x:Key="L_Theme_Coral">Coral</sys:String>
    <sys:String x:Key="L_Theme_Olive">Olive</sys:String>
    <sys:String x:Key="L_Theme_Plum">Plum</sys:String>
    <sys:String x:Key="L_Theme_Steel">Steel</sys:String>
    <sys:String x:Key="L_Theme_Slate">Slate</sys:String>

    <!-- A Sidequest's detail (5.6) -->
    <sys:String x:Key="L_ItemsFmt">{0} / {1} items</sys:String>
    <sys:String x:Key="L_CurrentObjective">Current objective</sys:String>
    <sys:String x:Key="L_SendObjective">Send objective</sys:String>
    <sys:String x:Key="L_AddItem">Add item</sys:String>
    <sys:String x:Key="L_DeleteItem">Delete item</sys:String>
    <sys:String x:Key="L_MoreOptions">More options</sys:String>
    <sys:String x:Key="L_Rename">Rename</sys:String>
    <sys:String x:Key="L_ChangeTheme">Change theme</sys:String>
    <sys:String x:Key="L_DeleteSidequest">Delete Sidequest</sys:String>
    <!-- 7 adds "and its Journal": it comes back in v1.1, when there is one. -->
    <sys:String x:Key="L_DeleteSidequestQ">Delete "{0}" with its {1} items?</sys:String>

    <!-- An objective's detail (5.3) -->
    <sys:String x:Key="L_NotesAndLinks">Notes and links</sys:String>
    <sys:String x:Key="L_LocalFiles">Local files</sys:String>
    <sys:String x:Key="L_LinkFile">Link file</sys:String>
    <sys:String x:Key="L_UnlinkFile">Unlink file</sys:String>
    <sys:String x:Key="L_FileMissing">File not found</sys:String>
    <sys:String x:Key="L_Images">Images</sys:String>
    <sys:String x:Key="L_AddImage">Add image</sys:String>
    <sys:String x:Key="L_RemoveImage">Remove image</sys:String>

    <!-- Tray (5.9). "Settings…" arrives with the settings window in phase 5. -->
    <sys:String x:Key="L_TrayShow">Show panel</sys:String>
    <sys:String x:Key="L_TraySidequests">Sidequests…</sys:String>
    <sys:String x:Key="L_TrayResetPosition">Reset position</sys:String>
    <sys:String x:Key="L_TrayQuit">Quit</sys:String>

    <!-- Migration (D3) -->
    <sys:String x:Key="L_ImportedSidequest">Imported</sys:String>

    <!-- Not in 7: the confirmation window's title, singulars, and the question for
         deleting an item. -->
    <sys:String x:Key="L_ConfirmTitle">Confirm</sys:String>
    <sys:String x:Key="L_ActiveOneFmt">{0} active</sys:String>
    <sys:String x:Key="L_DeleteItemQ">Delete this item?</sys:String>
    <sys:String x:Key="L_DeleteSidequestOneQ">Delete "{0}" with its one item?</sys:String>
    <sys:String x:Key="L_DeleteSidequestEmptyQ">Delete "{0}"?</sys:String>
    <!-- A thumbnail's name, for a screen reader. -->
    <sys:String x:Key="L_ImageFmt">Image {0}</sys:String>

</ResourceDictionary>
