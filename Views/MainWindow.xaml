<Window x:Class="Sidequest.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sidequest"
        Style="{StaticResource AppWindow}"
        Width="424"
        MinHeight="384"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <!-- The card is exactly the 400px of 5; the extra 24 on the window is the margin the
         shadow needs, since a frameless WPF window cannot paint outside itself. -->
    <Border x:Name="Card"
            Margin="12"
            CornerRadius="12"
            Background="{DynamicResource Bg}"
            BorderBrush="{DynamicResource Line2}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.28" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <!-- ============ Expanded ============ -->
            <Grid x:Name="ExpandedRoot">
                <Grid.RowDefinitions>
                    <!-- 37 as the artboard renders it; 4.4 says 36 and measures the content box. -->
                    <RowDefinition Height="37"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 4.4: the whole bar drags the window. Every artboard draws a 1px Line
                     under it, and the 37 already counts it. -->
                <Border Grid.Row="0"
                        Background="Transparent"
                        BorderBrush="{DynamicResource Line}"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="Drag_MouseLeftButtonDown">
                    <Grid>
                        <!-- Main panel: the name on the left, the window's buttons on the right. -->
                        <Grid x:Name="PanelBar">
                            <TextBlock Text="{DynamicResource L_AppName}"
                                       Style="{StaticResource AppName}"
                                       VerticalAlignment="Center"
                                       Margin="14,0,0,0"/>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0">
                                <ToggleButton x:Name="PinButton"
                                              Style="{StaticResource IconToggle}"
                                              ToolTip="{DynamicResource L_KeepOnTop}"
                                              AutomationProperties.Name="{DynamicResource L_KeepOnTop}"
                                              Checked="Pin_Changed"
                                              Unchecked="Pin_Changed">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Pin}"/>
                                </ToggleButton>
                                <Button Style="{StaticResource IconButton}"
                                        ToolTip="{DynamicResource L_Collapse}"
                                        AutomationProperties.Name="{DynamicResource L_Collapse}"
                                        Click="Collapse_Click">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronUp}"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}"
                                        ToolTip="{DynamicResource L_Close}"
                                        AutomationProperties.Name="{DynamicResource L_Close}"
                                        Click="Close_Click">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Close}"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Sub-panels (5.4-5.6): "‹ back" on the left, the name on the
                             right, and no window buttons - the artboards draw none, so
                             the panel is collapsed or closed from the main panel only. -->
                        <Grid x:Name="SubBar" Visibility="Collapsed">
                            <Button x:Name="BackButton"
                                    Style="{StaticResource BackLink}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="6,0,0,0"
                                    AutomationProperties.HelpText="{DynamicResource L_Back}"
                                    Click="Back_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Back}"/>
                                    <TextBlock x:Name="BackText" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="{DynamicResource L_AppName}"
                                       Style="{StaticResource AppName}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Panels 1-4 swap in here, with no transition (5).
                     Focusable=False: a ContentControl is focusable by default and was
                     taking an inert tab stop between the title bar and the first row. -->
                <ContentControl x:Name="ViewHost" Grid.Row="1" Focusable="False"/>
            </Grid>

            <!-- ============ Collapsed (5.2) ============
                 One 50px row. No app name and no pin, by design. -->
            <Grid x:Name="CollapsedRoot"
                  Height="50"
                  VerticalAlignment="Top"
                  Visibility="Collapsed"
                  Background="Transparent"
                  MouseLeftButtonDown="Drag_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="CollapsedDate"
                           Grid.Column="0"
                           Margin="14,0,8,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}"
                           TextTrimming="CharacterEllipsis"/>

                <Border Grid.Column="1"
                        Height="22"
                        Padding="9,0"
                        CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Text}">
                    <TextBlock x:Name="CollapsedCounter"
                               VerticalAlignment="Center"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Inv}"/>
                </Border>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="6,0,6,0">
                    <Button Style="{StaticResource IconButton}"
                            ToolTip="{DynamicResource L_Expand}"
                            AutomationProperties.Name="{DynamicResource L_Expand}"
                            Click="Collapse_Click">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronDown}"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            ToolTip="{DynamicResource L_Close}"
                            AutomationProperties.Name="{DynamicResource L_Close}"
                            Click="Close_Click">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Close}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

