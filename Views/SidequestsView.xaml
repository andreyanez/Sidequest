<UserControl x:Class="Sidequest.Views.SidequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sidequest.Views">

    <UserControl.Resources>
        <!-- 5.4's button, compact as D9 chose, from FnSidequestsCompacto: 42 as rendered,
             radius 10, padding 14, the name at 14/600 with the counter 11 clear of it, and
             a 2px bar along the bottom, 5 up, on C @ 20 %. 6 between buttons. -->
        <DataTemplate x:Key="SidequestRow" DataType="{x:Type local:SidequestButtonRow}">
            <Button Style="{StaticResource SidequestButton}"
                    Height="42"
                    Margin="0,0,0,6"
                    Padding="14,0"
                    Background="{Binding TintBrush}"
                    BorderBrush="{Binding BorderBrush}"
                    AutomationProperties.Name="{Binding AccessibleName}"
                    Click="Sidequest_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Name}"
                               Foreground="{Binding ThemeBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Counter}"
                               Style="{StaticResource Muted}"
                               Margin="11,0,0,0"
                               VerticalAlignment="Center"/>

                    <!-- The fill is a star column, so it needs no measuring and stays
                         proportional as the button narrows. -->
                    <Grid Grid.ColumnSpan="2"
                          Height="2"
                          Margin="0,0,0,5"
                          VerticalAlignment="Bottom">
                        <Border CornerRadius="1" Background="{Binding TrackBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding DoneWidth}"/>
                                <ColumnDefinition Width="{Binding RestWidth}"/>
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="1" Background="{Binding ThemeBrush}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header, 20/16/12: "Sidequests" alone at 22/700. 5.4 drops the counter, since
             nothing is ever archived and every Sidequest is always in the list. -->
        <TextBlock Grid.Row="0"
                   Margin="16,20,16,12"
                   Text="{DynamicResource L_Sidequests}"
                   Style="{StaticResource Heading}"/>

        <!-- The scrolling middle (5, 4.4). 2 above the first button, 12 below the last -
             6 here and the button's own 6 - and 14 on the right, where the thumb runs. -->
        <ScrollViewer x:Name="ListScroll"
                      Grid.Row="1"
                      Style="{StaticResource ScrollArea}"
                      Padding="12,2,14,6">
            <!-- Focusable=False: an ItemsControl takes a tab stop of its own. -->
            <ItemsControl x:Name="ProjectList"
                          Focusable="False"
                          ItemTemplate="{StaticResource SidequestRow}"/>
        </ScrollViewer>

        <!-- 5.4's fixed footer, 12/12/6 under a Line: "+ Nuevo Sidequest", or the form in
             its place while it is open (5.5), which grows the footer upward and leaves the
             list less room; then the resize grip, 8 below. -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource Line}"
                BorderThickness="0,1,0,0"
                Padding="12,12,12,6">
            <StackPanel>
                <Button x:Name="NewButton"
                        Style="{StaticResource DashedPillButton}"
                        AutomationProperties.Name="{DynamicResource L_NewSidequest}"
                        Click="New_Click">
                    <!-- The plus is 14px at stroke 2 on a 16-unit box: 0.875. -->
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}"
                              Data="{StaticResource Icon.Plus}"
                              StrokeThickness="2"
                              VerticalAlignment="Center">
                            <Path.LayoutTransform>
                                <ScaleTransform ScaleX="0.875" ScaleY="0.875"/>
                            </Path.LayoutTransform>
                        </Path>
                        <TextBlock Text="{DynamicResource L_NewSidequest}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 5.5's form. Tinted with the chosen theme at FnSidequestNuevo's 7 % with
                     a 40 % border, neither of which 4.2 lists, the tint running under the
                     border as CSS paints it. Padding 14 and sections 14 apart; labels 6
                     above the field and 8 above the swatches. Enter creates and Escape
                     cancels, from anywhere in it. -->
                <Grid x:Name="Form"
                      Visibility="Collapsed"
                      KeyDown="Form_KeyDown">
                    <Border x:Name="FormFill" CornerRadius="12"/>
                    <Border x:Name="FormEdge"
                            Padding="14"
                            CornerRadius="12"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="FormLabel" FontSize="11" FontWeight="SemiBold"/>

                            <TextBlock Text="{DynamicResource L_Name}"
                                       Style="{StaticResource Muted}"
                                       Margin="0,14,0,0"/>
                            <TextBox x:Name="NameBox"
                                     Style="{StaticResource TextBox.Themed}"
                                     Height="38"
                                     Margin="0,6,0,0"
                                     MaxLength="60"
                                     AutomationProperties.Name="{DynamicResource L_Name}"
                                     TextChanged="NameBox_TextChanged"/>

                            <TextBlock Text="{DynamicResource L_Theme}"
                                       Style="{StaticResource Muted}"
                                       Margin="0,14,0,0"/>
                            <ListBox x:Name="ThemePicker"
                                     Style="{StaticResource SwatchPicker}"
                                     Margin="0,8,0,0"
                                     AutomationProperties.Name="{DynamicResource L_Theme}"
                                     SelectionChanged="ThemePicker_SelectionChanged"/>

                            <!-- Pills, as FnSidequestNuevo draws them now. Both say 34, but
                                 Cancelar's border is outside it (content-box), so it renders 36
                                 and Crear 34, top-aligned. Cancelar has no fill, so the form's
                                 tint shows through it. -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                <Button Style="{StaticResource SecondaryButton}"
                                        Height="36"
                                        Background="Transparent"
                                        Content="{DynamicResource L_Cancel}"
                                        Click="Cancel_Click"/>
                                <Button x:Name="CreateButton"
                                        Style="{StaticResource PrimaryButton}"
                                        Height="34"
                                        Padding="18,0"
                                        VerticalAlignment="Top"
                                        Content="{DynamicResource L_Create}"
                                        Margin="8,0,0,0"
                                        IsEnabled="False"
                                        Click="Create_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource ResizeGrip}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
