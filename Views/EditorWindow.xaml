<Window x:Class="WeeklyReminder.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L_ThisWeeksList}"
        Style="{StaticResource AppWindow}"
        Width="620" Height="760"
        MinWidth="500" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource L_ThisWeeksList}" Style="{StaticResource HeadingText}" FontSize="17"/>
            <TextBlock x:Name="RangeText" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Add a new item -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="NewItemText"
                         Grid.Column="0"
                         Margin="0,0,8,0"
                         KeyDown="NewItemText_KeyDown"/>

                <Button Grid.Column="1"
                        Content="{DynamicResource L_Add}"
                        Style="{StaticResource PrimaryButton}"
                        Click="Add_Click"/>
            </Grid>
        </Border>

        <!-- Existing items -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto" Padding="10,8">
                    <!-- One drop target for the whole list; the row under the pointer is
                         found by hit test. Per-row AllowDrop did not resolve reliably as
                         the pointer moved between rows mid-drag. -->
                    <ItemsControl x:Name="ItemList"
                                  AllowDrop="True"
                                  PreviewDragOver="List_DragOver"
                                  PreviewDragLeave="List_DragLeave"
                                  PreviewDrop="List_Drop">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Tag="Row"
                                        Background="Transparent"
                                        CornerRadius="6"
                                        Padding="2,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding Done, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  ToolTip="{DynamicResource L_DoneTooltip}"/>

                                        <!-- Wraps rather than scrolling out of sight; Enter
                                             must not insert a newline into an item name. -->
                                        <TextBox Grid.Column="1"
                                                 Margin="6,0,8,0"
                                                 VerticalAlignment="Center"
                                                 VerticalContentAlignment="Top"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="False"
                                                 Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                        <CheckBox Grid.Column="2"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding RepeatsWeekly, Mode=TwoWay}"
                                                  Content="{DynamicResource L_Weekly}"
                                                  ToolTip="{DynamicResource L_WeeklyTooltip}"/>

                                        <!-- Action bar -->
                                        <Border Grid.Column="3"
                                                Margin="10,0,0,0"
                                                Background="{DynamicResource PageBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="Transparent"
                                                        Cursor="SizeAll"
                                                        Padding="7,4"
                                                        ToolTip="{DynamicResource L_DragToReorder}"
                                                        PreviewMouseLeftButtonDown="DragHandle_MouseDown"
                                                        PreviewMouseLeftButtonUp="DragHandle_MouseUp"
                                                        PreviewMouseMove="DragHandle_MouseMove">
                                                    <TextBlock Text="⋮⋮"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource MutedBrush}"/>
                                                </Border>

                                                <Button Style="{StaticResource IconButton}"
                                                        Content="✕"
                                                        ToolTip="{DynamicResource L_Remove}"
                                                        Click="Remove_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="EmptyState"
                           Text="{DynamicResource L_EditorEmpty}"
                           Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="{DynamicResource L_ClearCompleted}" Click="ClearCompleted_Click"/>

            <TextBlock Grid.Column="1"
                       Style="{StaticResource MutedText}"
                       VerticalAlignment="Center"
                       Margin="12,0,8,0"
                       TextTrimming="CharacterEllipsis"
                       Text="{DynamicResource L_DragHint}"/>

            <Button Grid.Column="2" Content="{DynamicResource L_PopupTimes}" Margin="0,0,6,0" Click="Settings_Click"/>
            <Button Grid.Column="3" Content="{DynamicResource L_Done}" Style="{StaticResource PrimaryButton}" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
