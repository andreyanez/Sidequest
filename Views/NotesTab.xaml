<UserControl x:Class="Sidequest.Views.NotesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sidequest.Views"
             AllowDrop="True"
             PreviewDragOver="View_PreviewDragOver"
             PreviewDragLeave="View_PreviewDragLeave"
             PreviewDrop="View_PreviewDrop">

    <UserControl.Resources>
        <!-- A linked file: a 42px row and its separator, 43 as FnSidequestNotas renders it.
             The whole row opens the file; unlinking is its own button, 6 from the edge. -->
        <DataTemplate DataType="{x:Type local:FileRow}">
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                <Grid>
                    <Button Style="{StaticResource FileRowButton}"
                            ToolTip="{Binding MissingNote}"
                            AutomationProperties.Name="{Binding Name}"
                            AutomationProperties.HelpText="{Binding Folder}"
                            Click="OpenFile_Click">
                        <!-- 12 in; icon, 10, name, 10, folder; and 44 kept clear on the
                             right for the unlink button (6 + 28 + 10). -->
                        <Grid Margin="12,0,44,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Style="{StaticResource IconPath}"
                                  Data="{StaticResource Icon.File}"
                                  Stroke="{DynamicResource Text2}"
                                  VerticalAlignment="Center"/>
                            <TextBlock x:Name="FileName"
                                       Grid.Column="1"
                                       Text="{Binding Name}"
                                       FontSize="13"
                                       Foreground="{DynamicResource Text}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Folder}"
                                       FontSize="11"
                                       Foreground="{DynamicResource Text2}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0"
                            ToolTip="{DynamicResource L_UnlinkFile}"
                            AutomationProperties.Name="{DynamicResource L_UnlinkFile}"
                            AutomationProperties.HelpText="{Binding Name}"
                            Click="Unlink_Click">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Close}"/>
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <!-- 5.6: a file that has gone reads in Text2, and the row's tooltip says why. -->
                <DataTrigger Binding="{Binding Exists}" Value="False">
                    <Setter TargetName="FileName" Property="Foreground" Value="{DynamicResource Text2}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- The image grid's three kinds of cell, 66 high. -->
        <DataTemplate DataType="{x:Type local:ImageThumb}">
            <Grid x:Name="Cell" local:KeyboardCue.Track="True">
                <Button Style="{StaticResource ImageCellButton}"
                        Background="{Binding Thumbnail}"
                        AutomationProperties.Name="{Binding Label}"
                        Click="OpenImage_Click">
                    <Path x:Name="MissingIcon"
                          Style="{StaticResource IconPath}"
                          Data="{StaticResource Icon.Image}"
                          Visibility="Collapsed"/>
                </Button>
                <Button x:Name="Remove"
                        Style="{StaticResource OverlayButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,5,5,0"
                        Visibility="Collapsed"
                        ToolTip="{DynamicResource L_RemoveImage}"
                        AutomationProperties.Name="{DynamicResource L_RemoveImage}"
                        AutomationProperties.HelpText="{Binding Label}"
                        Click="RemoveImage_Click">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Close}">
                        <Path.LayoutTransform>
                            <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                        </Path.LayoutTransform>
                    </Path>
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter TargetName="MissingIcon" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <!-- 5.6's "quitar" appears on hover; keyboard focus inside the cell shows
                     it too, or the keyboard could never reach it (KeyboardCue: a click's
                     focus does not). -->
                <Trigger SourceName="Cell" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Remove" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger SourceName="Cell" Property="local:KeyboardCue.Within" Value="True">
                    <Setter TargetName="Remove" Property="Visibility" Value="Visible"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:AddImageSlot}">
            <Button Style="{StaticResource DashedCell}"
                    ToolTip="{DynamicResource L_AddImage}"
                    AutomationProperties.Name="{DynamicResource L_AddImage}"
                    Click="AddImage_Click">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Plus}"/>
            </Button>
        </DataTemplate>

        <!-- The unused cells are dashed in Line, fainter than the "+" cell's Line2. -->
        <DataTemplate DataType="{x:Type local:EmptyImageSlot}">
            <Rectangle Height="66"
                       Stroke="{DynamicResource Line}"
                       StrokeThickness="1"
                       StrokeDashArray="3 2"
                       RadiusX="9.5"
                       RadiusY="9.5"
                       SnapsToDevicePixels="True"/>
        </DataTemplate>
    </UserControl.Resources>

    <!-- FnSidequestNotas: padding 16, sections 18 apart, each a header row of 16 and then
         its content 8 below. It scrolls like any compact screen's middle (5, 4.4). -->
    <ScrollViewer Style="{StaticResource ScrollArea}" Padding="16,16,16,16">
        <StackPanel>
            <!-- Notes and links. The label sits 1 lower than the counter: both are on one
                 baseline in the artboard, at 11 and 12px. -->
            <Grid Height="16">
                <TextBlock x:Name="NotesLabel" Style="{StaticResource SectionLabel}" Margin="0,1,0,0" VerticalAlignment="Top"/>
                <TextBlock x:Name="NotesCounter" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>
            <RichTextBox x:Name="NotesBox"
                         Style="{StaticResource NotesBox}"
                         Margin="0,8,0,0"
                         AutomationProperties.Name="{DynamicResource L_NotesAndLinks}"
                         TextChanged="NotesBox_TextChanged"
                         PreviewTextInput="NotesBox_PreviewTextInput"
                         PreviewKeyDown="NotesBox_PreviewKeyDown"
                         PreviewMouseLeftButtonDown="NotesBox_PreviewMouseLeftButtonDown"
                         LostKeyboardFocus="NotesBox_LostKeyboardFocus"
                         Hyperlink.RequestNavigate="Link_RequestNavigate"/>

            <!-- Local files -->
            <Grid Height="16" Margin="0,18,0,0">
                <TextBlock x:Name="FilesLabel" Style="{StaticResource SectionLabel}" Margin="0,1,0,0" VerticalAlignment="Top"/>
                <TextBlock x:Name="FilesCounter" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>
            <Border Margin="0,8,0,0"
                    CornerRadius="10"
                    Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Line}"
                    BorderThickness="1">
                <!-- Clipped to the list's inner corners in code: a Border rounds only
                     itself, and the rows' hover fill would square them off. -->
                <StackPanel x:Name="FileListContent" SizeChanged="FileListContent_SizeChanged">
                    <ItemsControl x:Name="FileRows" Focusable="False"/>
                    <Button x:Name="LinkFileButton"
                            Style="{StaticResource ListActionButton}"
                            AutomationProperties.Name="{DynamicResource L_LinkFile}"
                            Click="LinkFile_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Plus}"/>
                            <TextBlock Text="{DynamicResource L_LinkFile}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Images: five equal cells 8 apart. A UniformGrid has no gap, so each cell
                 carries 8 on its right and the grid reaches 8 past the edge to make up for
                 the last one: (366 + 8) / 5 - 8 = 66.8, the artboard's cell. -->
            <Grid Height="16" Margin="0,18,0,0">
                <TextBlock x:Name="ImagesLabel" Style="{StaticResource SectionLabel}" Margin="0,1,0,0" VerticalAlignment="Top"/>
                <TextBlock x:Name="ImagesCounter" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </Grid>
            <ItemsControl x:Name="ImageList" Margin="0,8,-8,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="5"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="0,0,8,0"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
