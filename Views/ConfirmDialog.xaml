<Window x:Class="WeeklyReminder.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm"
        Width="400"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Border Margin="12"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.22" Color="#000000"/>
        </Border.Effect>

        <StackPanel Margin="20,18,20,16">
            <TextBlock x:Name="HeadingText"
                       Style="{StaticResource HeadingText}"
                       FontSize="15"
                       TextWrapping="Wrap"/>

            <Border Background="{DynamicResource PageBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,8"
                    Margin="0,12,0,0">
                <TextBlock x:Name="DetailText" TextWrapping="Wrap"/>
            </Border>

            <TextBlock x:Name="FooterNote"
                       Style="{StaticResource MutedText}"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        MinWidth="84"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Cancel_Click"/>
                <Button x:Name="ConfirmButton"
                        Style="{StaticResource DangerButton}"
                        MinWidth="84"
                        IsDefault="True"
                        Click="Confirm_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
