<Window x:Class="Sidequest.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L_ConfirmTitle}"
        Style="{StaticResource AppWindow}"
        Width="400"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=ConfirmButton}">

    <!-- Focus starts on the default button, as a Windows message box's does: Enter answers
         the question either way, and the ring shows which way it will go. WPF only draws
         the ring after keyboard input, so opening the dialog with the mouse shows none. -->

    <!-- No artboard shows this dialog, so it is held to 4.2-4.4 and the panel it sits on:
         the same Bg card, radius 12 and Line2 frame as MainWindow (6), the subject in a
         Surface box like a card, and Text/Inv for the one primary action. No red - 4.2 has
         none, and destructive actions are marked by asking, not by colour. -->
    <Border Margin="12"
            Background="{DynamicResource Bg}"
            BorderBrush="{DynamicResource Line2}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.28" Color="#000000"/>
        </Border.Effect>

        <StackPanel Margin="20,18,20,16">
            <TextBlock x:Name="HeadingText"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Text}"
                       TextWrapping="Wrap"/>

            <Border x:Name="DetailBox"
                    Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Line}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,10"
                    Margin="0,12,0,0">
                <TextBlock x:Name="DetailText"
                           Style="{StaticResource ItemText}"
                           TextTrimming="None"
                           TextWrapping="Wrap"/>
            </Border>

            <TextBlock x:Name="FooterNote"
                       Style="{StaticResource Muted}"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">
                <Button x:Name="CancelButton"
                        Style="{StaticResource SecondaryButton}"
                        Content="{DynamicResource L_Cancel}"
                        IsCancel="True"
                        Click="Cancel_Click"/>
                <Button x:Name="ConfirmButton"
                        Style="{StaticResource PrimaryButton}"
                        Margin="8,0,0,0"
                        IsDefault="True"
                        Click="Confirm_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
