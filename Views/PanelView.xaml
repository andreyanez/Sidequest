<UserControl x:Class="Sidequest.Views.PanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- Header: 5.1 gives it 22/16/14 padding, 16 lateral per 4.3 -->
        <StackPanel Grid.Row="0" Margin="16,22,16,14">
            <Grid>
                <TextBlock x:Name="WeekdayText" Style="{StaticResource Sq.SectionLabel}"/>
                <TextBlock x:Name="CounterText"
                           Style="{StaticResource Sq.Muted}"
                           HorizontalAlignment="Right"/>
            </Grid>
            <TextBlock x:Name="DateText" Style="{StaticResource Sq.Heading}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Objectives. 12 lateral padding and a 6px gap between cards, per 4.3 -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="ListScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="12,0,12,0">
                <ItemsControl x:Name="ObjectiveList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Card"
                                    Height="50"
                                    Margin="0,0,0,6"
                                    Padding="14,0,8,0"
                                    CornerRadius="10"
                                    Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              Style="{StaticResource Sq.CheckBox}"
                                              VerticalAlignment="Center"
                                              Background="{Binding ThemeBrush}"
                                              IsChecked="{Binding Item.Done, Mode=TwoWay}"
                                              Checked="Done_Changed"
                                              Unchecked="Done_Changed"/>

                                    <!-- Click opens the objective's detail; that view arrives in phase 4. -->
                                    <TextBlock x:Name="ItemText"
                                               Grid.Column="1"
                                               Margin="12,0,12,0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource Sq.ItemText}"
                                               Text="{Binding Item.Text}"/>

                                    <!-- Chip. The name is truncated rather than shortened: the model
                                         carries one name, and an abbreviation would be a second field. -->
                                    <Border Grid.Column="2"
                                            Height="24"
                                            Padding="9,0"
                                            CornerRadius="999"
                                            Background="{DynamicResource Surface}"
                                            BorderBrush="{DynamicResource Line}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProjectName}"
                                                   Foreground="{Binding ThemeBrush}"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   VerticalAlignment="Center"
                                                   MaxWidth="96"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>

                                    <!-- 5.1: both appear on hover only -->
                                    <StackPanel x:Name="Actions"
                                                Grid.Column="3"
                                                Orientation="Horizontal"
                                                Margin="4,0,-6,0"
                                                VerticalAlignment="Center"
                                                Visibility="Collapsed">
                                        <Button Style="{StaticResource Sq.IconButton}"
                                                ToolTip="{DynamicResource L_ReturnToSidequest}"
                                                Click="Return_Click">
                                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Return}"/>
                                        </Button>
                                        <Button Style="{StaticResource Sq.IconButton}"
                                                ToolTip="{DynamicResource L_DeleteObjective}"
                                                Click="Delete_Click">
                                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Delete}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Item.Done}" Value="True">
                                    <Setter TargetName="ItemText" Property="Foreground" Value="{DynamicResource Text2}"/>
                                    <Setter TargetName="ItemText" Property="TextDecorations" Value="Strikethrough"/>
                                </DataTrigger>
                                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource Hover}"/>
                                    <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="EmptyState"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        Margin="28,0,28,12">
                <TextBlock Style="{StaticResource Sq.Muted}"
                           Text="{DynamicResource L_PanelEmpty}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
                <Button Style="{StaticResource Sq.PrimaryButton}"
                        HorizontalAlignment="Center"
                        Margin="0,14,0,0"
                        Click="Sidequests_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource L_Sidequests}" VerticalAlignment="Center"/>
                        <Path Style="{StaticResource IconPath}"
                              Data="{StaticResource Icon.ArrowRight}"
                              Margin="6,0,-4,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Button Style="{StaticResource Sq.PrimaryButton}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Click="Sidequests_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource L_Sidequests}" VerticalAlignment="Center"/>
                        <Path Style="{StaticResource IconPath}"
                              Data="{StaticResource Icon.ArrowRight}"
                              Margin="6,0,-4,0"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource Sq.IconButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        ToolTip="{DynamicResource L_Settings}"
                        Click="Settings_Click">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Settings}"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
