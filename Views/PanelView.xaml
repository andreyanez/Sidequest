<UserControl x:Class="Sidequest.Views.PanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sidequest.Views"
             PreviewMouseLeftButtonDown="View_PreviewMouseLeftButtonDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <!-- 61 = the 60 of 5.1 plus its 1px top border, as the artboard renders it. -->
            <RowDefinition Height="61"/>
        </Grid.RowDefinitions>

        <!-- Header: 5.1 gives it 22/16/14 padding, 16 lateral per 4.3 -->
        <StackPanel Grid.Row="0" Margin="16,22,16,14">
            <!-- FnMain sets the weekday on the counter's baseline. Both top-aligned, the
                 11px weekday would sit a pixel above the 12px counter, the difference in
                 their ascents. -->
            <Grid>
                <TextBlock x:Name="WeekdayText" Style="{StaticResource SectionLabel}" Margin="0,1,0,0"/>
                <TextBlock x:Name="CounterText"
                           Style="{StaticResource Muted}"
                           HorizontalAlignment="Right"/>
            </Grid>
            <!-- FnMain puts the date 6 below the weekday on a 1.15 line (25.3), the one
                 heading in the artboards not on its font's natural line (28.6). CSS centres
                 the natural line in the shorter one, so the text starts 1.67 above the
                 line's box and runs 1.67 past it; the margins do the same, in the whole
                 pixels Chrome paints (layout rounding would round 4.33 and -1.67 apart,
                 but their sum as one). WPF's own LineHeight would scale the baseline
                 instead, and set the date a pixel high. -->
            <TextBlock x:Name="DateText"
                       Style="{StaticResource Heading}"
                       Margin="0,4,0,-2"/>
        </StackPanel>

        <!-- Objectives. 12 lateral padding and a 6px gap between cards, per 4.3, and 12
             above the first card, as FnMain's list pads its top -->
        <Grid Grid.Row="1">
            <!-- 5.1: the list is the scrolling middle, with 4.4's cues; the date above and
                 the footer below stay put. ScrollArea makes it unfocusable, for the same
                 reason as the ItemsControl below: otherwise it takes a tab stop of its own
                 between the title bar and the first row. -->
            <ScrollViewer x:Name="ListScroll"
                          Style="{StaticResource ScrollArea}"
                          KeyDown="List_KeyDown">
                <!-- The list's padding is a margin inside what scrolls, not ScrollArea's
                     Padding, which sits outside the clip: a dragged card, 6 to the right,
                     and its shadow reach into it, as FnMainDrag's do. -->
                <Grid Margin="12,12,12,0">
                    <!-- The gap a dragged card will land in (4.4), behind the cards so the card
                         passes over it. DragReorder fills it. -->
                    <Canvas x:Name="DragLayer" IsHitTestVisible="False"/>
                    <!-- Focusable=False: an ItemsControl takes a tab stop of its own by
                         default, which put an inert stop before the first checkbox. -->
                    <ItemsControl x:Name="ObjectiveList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,6">
                                    <!-- FnMain (4.4): 50 with its border, padding 4 and 8, 8
                                         between parts, starting with the grip. The text is not a
                                         link (5.1). -->
                                    <Border x:Name="Card"
                                            Height="50"
                                            Padding="4,0,8,0"
                                            CornerRadius="10"
                                            Background="{DynamicResource Surface}"
                                            BorderBrush="{DynamicResource Line}"
                                            BorderThickness="1"
                                            LostKeyboardFocus="Card_LostKeyboardFocus"
                                            local:KeyboardCue.Track="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Unseen at rest, but always in its place (4.4). -->
                                            <Thumb x:Name="Grip"
                                                   Style="{StaticResource Grip}"
                                                   Opacity="0"
                                                   AutomationProperties.Name="{DynamicResource L_DragToReorder}"
                                                   AutomationProperties.HelpText="{Binding Item.Text}"
                                                   DragStarted="Grip_DragStarted"
                                                   DragDelta="Grip_DragDelta"
                                                   DragCompleted="Grip_DragCompleted"/>

                                            <!-- The label is a sibling TextBlock rather than the
                                                 box's content, so the name has to be set for it
                                                 or the box announces itself with no label. -->
                                            <CheckBox x:Name="Check"
                                                      Grid.Column="1"
                                                      Margin="8,0,0,0"
                                                      VerticalAlignment="Center"
                                                      Background="{Binding ThemeBrush}"
                                                      AutomationProperties.Name="{Binding Item.Text}"
                                                      IsChecked="{Binding Item.Done, Mode=TwoWay}"
                                                      Checked="Done_Changed"
                                                      Unchecked="Done_Changed"/>

                                            <!-- 8 and the text's own 4. -->
                                            <TextBlock x:Name="ItemText"
                                                       Grid.Column="2"
                                                       Margin="12,0,0,0"
                                                       Style="{StaticResource ItemText}"
                                                       Text="{Binding Item.Text}"
                                                       VerticalAlignment="Center"/>
                                            <!-- 10 and TextBox's own 2. -->
                                            <TextBox x:Name="NameEdit"
                                                     Grid.Column="2"
                                                     Margin="10,0,0,0"
                                                     Style="{StaticResource BareTextBox}"
                                                     MaxLength="120"
                                                     Visibility="Collapsed"
                                                     CaretBrush="{Binding ThemeBrush}"
                                                     AutomationProperties.Name="{DynamicResource L_RenameObjective}"
                                                     KeyDown="ItemNameEdit_KeyDown"/>

                                            <!-- Chip: opens the Sidequest (5.1). A button, so the
                                                 keyboard reaches it too. The name is truncated
                                                 rather than shortened: the model carries one name,
                                                 and an abbreviation would be a second field. -->
                                            <Button x:Name="ChipButton"
                                                    Grid.Column="3"
                                                    Margin="8,0,0,0"
                                                    Style="{StaticResource Chip}"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="{Binding ProjectName}"
                                                    Click="Chip_Click">
                                                <TextBlock Text="{Binding ProjectName}"
                                                           Foreground="{Binding ThemeBrush}"
                                                           FontSize="11"
                                                           FontWeight="Medium"
                                                           VerticalAlignment="Center"
                                                           MaxWidth="96"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Button>

                                            <!-- 5.1: rename, return and delete appear on hover,
                                                 8 after the chip and none apart. At rest they have
                                                 no width, no opacity and no hit-testing, rather than
                                                 being collapsed: unseen, taking no room and no
                                                 clicks, but still tab stops, and still there for a
                                                 screen reader. Not clipped, which would clip the
                                                 focus ring too. -->
                                            <StackPanel x:Name="Actions"
                                                        Grid.Column="4"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Width="0"
                                                        Opacity="0"
                                                        IsHitTestVisible="False">
                                                <Button x:Name="RenameButton"
                                                        Style="{StaticResource IconButton}"
                                                        ToolTip="{DynamicResource L_RenameObjective}"
                                                        AutomationProperties.Name="{DynamicResource L_RenameObjective}"
                                                        AutomationProperties.HelpText="{Binding Item.Text}"
                                                        Click="Rename_Click">
                                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Rename}"/>
                                                </Button>
                                                <Button Style="{StaticResource IconButton}"
                                                        ToolTip="{DynamicResource L_ReturnToSidequest}"
                                                        AutomationProperties.Name="{DynamicResource L_ReturnToSidequest}"
                                                        AutomationProperties.HelpText="{Binding Item.Text}"
                                                        Click="Return_Click">
                                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Return}"/>
                                                </Button>
                                                <Button Style="{StaticResource IconButton}"
                                                        ToolTip="{DynamicResource L_DeleteObjective}"
                                                        AutomationProperties.Name="{DynamicResource L_DeleteObjective}"
                                                        AutomationProperties.HelpText="{Binding Item.Text}"
                                                        Click="Delete_Click">
                                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Delete}"/>
                                                </Button>
                                            </StackPanel>

                                            <!-- FnMainEdit: the check in C and the x, 8 apart. -->
                                            <Button x:Name="SaveName"
                                                    Grid.Column="3"
                                                    Margin="8,0,0,0"
                                                    Style="{StaticResource SaveNameButton}"
                                                    VerticalAlignment="Center"
                                                    Visibility="Collapsed"
                                                    ToolTip="{DynamicResource L_SaveName}"
                                                    AutomationProperties.Name="{DynamicResource L_SaveName}"
                                                    Click="SaveName_Click">
                                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Check}"/>
                                            </Button>
                                            <Button x:Name="CancelName"
                                                    Grid.Column="4"
                                                    Margin="8,0,0,0"
                                                    Style="{StaticResource IconButton}"
                                                    VerticalAlignment="Center"
                                                    Visibility="Collapsed"
                                                    ToolTip="{DynamicResource L_Cancel}"
                                                    AutomationProperties.Name="{DynamicResource L_Cancel}"
                                                    Click="CancelName_Click">
                                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Close}"/>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- FnMainEdit's hint, right-aligned 6 in, 4 under the card. -->
                                    <StackPanel x:Name="EditHint"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,4,6,0"
                                                Visibility="Collapsed">
                                        <TextBlock Text="{DynamicResource L_EnterSaves}" FontSize="11" Foreground="{DynamicResource Text2}"/>
                                        <TextBlock Text="{DynamicResource L_EscCancels}" FontSize="11" Foreground="{DynamicResource Text2}" Margin="12,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Item.Done}" Value="True">
                                        <Setter TargetName="ItemText" Property="Foreground" Value="{DynamicResource Text2}"/>
                                        <Setter TargetName="ItemText" Property="TextDecorations" Value="Strikethrough"/>
                                    </DataTrigger>
                                    <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource Hover}"/>
                                        <Setter TargetName="Grip" Property="Opacity" Value="1"/>
                                        <Setter TargetName="Actions" Property="Width" Value="Auto"/>
                                        <Setter TargetName="Actions" Property="Margin" Value="8,0,0,0"/>
                                        <Setter TargetName="Actions" Property="Opacity" Value="1"/>
                                        <Setter TargetName="Actions" Property="IsHitTestVisible" Value="True"/>
                                    </Trigger>
                                    <!-- Keyboard focus anywhere in the card shows them too, so Tab
                                         reveals each as it reaches it - focus the keyboard put
                                         there, not a click's (KeyboardCue). -->
                                    <Trigger SourceName="Card" Property="local:KeyboardCue.Within" Value="True">
                                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource Hover}"/>
                                        <Setter TargetName="Grip" Property="Opacity" Value="1"/>
                                        <Setter TargetName="Actions" Property="Width" Value="Auto"/>
                                        <Setter TargetName="Actions" Property="Margin" Value="8,0,0,0"/>
                                        <Setter TargetName="Actions" Property="Opacity" Value="1"/>
                                        <Setter TargetName="Actions" Property="IsHitTestVisible" Value="True"/>
                                    </Trigger>
                                    <!-- FnMainDrag (4.4's "tarjeta arrastrada"): on Surface with a
                                         Line2 border and a shadow 10 down, black at 45 %, its grip
                                         showing and its actions not. CSS's blur of 24 is a Gaussian
                                         of sigma 12, and WPF's BlurRadius is about three sigmas:
                                         36 matched FnMainDrag to a level in light, where it shows. -->
                                    <DataTrigger Binding="{Binding IsLifted}" Value="True">
                                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource Surface}"/>
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Line2}"/>
                                        <Setter TargetName="Card" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="36" ShadowDepth="10" Direction="270" Opacity="0.45" Color="Black"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter TargetName="Grip" Property="Opacity" Value="1"/>
                                        <Setter TargetName="Actions" Property="Width" Value="0"/>
                                        <Setter TargetName="Actions" Property="Margin" Value="0"/>
                                        <Setter TargetName="Actions" Property="Opacity" Value="0"/>
                                        <Setter TargetName="Actions" Property="IsHitTestVisible" Value="False"/>
                                    </DataTrigger>
                                    <!-- FnMainEdit (4.4's "tarjeta en edición"): a border in C -
                                         1.5 drawn as 1, see CheckBox - padding 26 and 6, no grip
                                         or chip, the field 14/500 with a C caret, then the check
                                         and the x. Last, so it wins over hover and focus. -->
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource Surface}"/>
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{Binding ThemeBrush}"/>
                                        <Setter TargetName="Card" Property="Padding" Value="26,0,6,0"/>
                                        <Setter TargetName="Grip" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="Check" Property="Margin" Value="0"/>
                                        <Setter TargetName="ItemText" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="NameEdit" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="ChipButton" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="Actions" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="SaveName" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="CancelName" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="EditHint" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

            <StackPanel x:Name="EmptyState"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        Margin="28,0,28,12">
                <TextBlock Style="{StaticResource Muted}"
                           Text="{DynamicResource L_PanelEmpty}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
                <Button x:Name="EmptySidequestsButton"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Center"
                        Margin="0,14,0,0"
                        AutomationProperties.Name="{DynamicResource L_Sidequests}"
                        Click="Sidequests_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource L_Sidequests}" VerticalAlignment="Center"/>
                        <Path Style="{StaticResource IconPath}"
                              Data="{StaticResource Icon.ArrowRight}"
                              Margin="6,0,-4,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <!-- Asymmetric, as FnMain pads it: 12 left, 10 right. -->
            <Grid Margin="12,0,10,0">
                <Button x:Name="SidequestsButton"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{DynamicResource L_Sidequests}"
                        Click="Sidequests_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource L_Sidequests}" VerticalAlignment="Center"/>
                        <Path Style="{StaticResource IconPath}"
                              Data="{StaticResource Icon.ArrowRight}"
                              Margin="6,0,-4,0"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource RoundIconButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        ToolTip="{DynamicResource L_Settings}"
                        AutomationProperties.Name="{DynamicResource L_Settings}"
                        Click="Settings_Click">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Settings}"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
