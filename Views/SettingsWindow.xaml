<Window x:Class="WeeklyReminder.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L_SettingsTitle}"
        Style="{StaticResource AppWindow}"
        Width="470" Height="812"
        MinWidth="430" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource L_Settings}"
                   Style="{StaticResource HeadingText}"
                   FontSize="17"
                   Margin="0,0,0,14"/>

        <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Popup times -->
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L_WhenItPopsUp}" Style="{StaticResource HeadingText}"/>
                        <TextBlock Text="{DynamicResource L_TimesHelp}"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,2,0,10"/>

                        <ItemsControl x:Name="TimeList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Display}"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Content="{DynamicResource L_Remove}"
                                                Padding="8,3"
                                                FontSize="12"
                                                Foreground="{DynamicResource MutedBrush}"
                                                Click="RemoveTime_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewTimeText"
                                     Grid.Column="0"
                                     Margin="0,0,8,0"
                                     KeyDown="NewTimeText_KeyDown"/>
                            <Button Grid.Column="1"
                                    Content="{DynamicResource L_AddTime}"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="AddTime_Click"/>
                        </Grid>

                        <TextBlock x:Name="TimeHint"
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Text="{DynamicResource L_TimeHintDefault}"/>
                    </StackPanel>
                </Border>

                <!-- Active days -->
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L_OnWhichDays}" Style="{StaticResource HeadingText}"/>
                        <WrapPanel x:Name="DaysPanel" Margin="0,8,0,0"/>
                        <TextBlock x:Name="DaysHint"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,6,0,0"
                                   Visibility="Collapsed"
                                   Text="{DynamicResource L_DaysHint}"/>
                    </StackPanel>
                </Border>

                <!-- Behaviour -->
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L_Behaviour}" Style="{StaticResource HeadingText}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource L_SnoozeFor}" VerticalAlignment="Center"/>
                            <!-- Explicit ItemTemplate rather than DisplayMemberPath: the
                                 custom ComboBox template renders SelectionBoxItem, which
                                 falls back to ToString() when only a path is given. -->
                            <ComboBox x:Name="SnoozeBox"
                                      Grid.Column="1"
                                      Width="165"
                                      SelectedValuePath="Value"
                                      SelectionChanged="SnoozeBox_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource L_ClosePopupAfter}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="AutoCloseBox"
                                      Grid.Column="1"
                                      Width="165"
                                      SelectedValuePath="Value"
                                      SelectionChanged="AutoCloseBox_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <CheckBox x:Name="KeepOnTopBox"
                                  Content="{DynamicResource L_KeepOnTop}"
                                  Margin="0,14,0,0"
                                  Checked="KeepOnTop_Changed"
                                  Unchecked="KeepOnTop_Changed"/>
                        <TextBlock Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Text="{DynamicResource L_KeepOnTopHelp}"/>
                    </StackPanel>
                </Border>

                <!-- Appearance -->
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L_Appearance}" Style="{StaticResource HeadingText}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="DarkModeBox"
                                  Content="{DynamicResource L_DarkMode}"
                                  Checked="DarkMode_Changed"
                                  Unchecked="DarkMode_Changed"/>
                        <TextBlock Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Text="{DynamicResource L_DarkModeHelp}"/>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{DynamicResource L_Language}"
                                       VerticalAlignment="Center"/>
                            <!-- Language names are deliberately not translated: a picker is
                                 only useful if you can find your language in it. -->
                            <ComboBox x:Name="LanguageBox"
                                      Grid.Column="1"
                                      Width="165"
                                      SelectedValuePath="Value"
                                      SelectionChanged="LanguageBox_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Startup -->
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L_Startup}" Style="{StaticResource HeadingText}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="StartWithWindowsBox"
                                  Content="{DynamicResource L_OpenOnStartup}"
                                  Checked="StartWithWindows_Changed"
                                  Unchecked="StartWithWindows_Changed"/>
                        <TextBlock Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Text="{DynamicResource L_StartupHelp}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="{DynamicResource L_PreviewPopup}" Click="Preview_Click"/>
            <Button Grid.Column="2" Content="{DynamicResource L_Done}" Style="{StaticResource PrimaryButton}" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
