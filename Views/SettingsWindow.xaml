<Window x:Class="Sidequest.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L_Settings}"
        Style="{StaticResource AppWindow}"
        Width="744"
        Height="544"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True">

    <!-- 5.8: 720 x 520, not resizable, as FnAjustes draws it. The 12 around the card is
         room for the shadow, as on MainWindow. -->
    <Border Margin="12"
            CornerRadius="12"
            Background="{DynamicResource Bg}"
            BorderBrush="{DynamicResource Line2}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.28" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="37"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- The sub-panels' bar. "‹ Panel principal" closes this window and brings the
                 panel back; the whole bar drags. -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    BorderBrush="{DynamicResource Line}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Drag_MouseLeftButtonDown">
                <Grid>
                    <Button Style="{StaticResource BackLink}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="6,0,0,0"
                            AutomationProperties.Name="{DynamicResource L_MainPanel}"
                            AutomationProperties.HelpText="{DynamicResource L_Back}"
                            Click="Back_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Back}"/>
                            <TextBlock Text="{DynamicResource L_MainPanel}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{DynamicResource L_AppName}"
                               Style="{StaticResource AppName}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0"/>
                </Grid>
            </Border>

            <!-- Padding 28/40. "Ajustes" is 22/600: FnAjustes sets 600 where 4.1 says 700, as
                 FnSidequests does for "Sidequests". Then four rows of 80 between Line rules,
                 each a 14/500 title over a 12px description, 3 apart, with its control on the
                 right. -->
            <StackPanel Grid.Row="1" Margin="40,28,40,0">
                <TextBlock Text="{DynamicResource L_Settings}"
                           Style="{StaticResource Heading}"
                           FontWeight="SemiBold"
                           Height="29"
                           Margin="0,0,0,14"/>

                <Border Height="81" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource L_Appearance}" FontSize="14" FontWeight="Medium" Height="18"/>
                            <TextBlock Text="{DynamicResource L_AppearanceHelp}" Style="{StaticResource Muted}" Height="16" Margin="0,3,0,0"/>
                        </StackPanel>
                        <ListBox x:Name="AppearancePicker"
                                 Style="{StaticResource Segmented}"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center"
                                 AutomationProperties.Name="{DynamicResource L_Appearance}"
                                 SelectionChanged="Appearance_SelectionChanged"/>
                    </Grid>
                </Border>

                <Border Height="81" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource L_Language}" FontSize="14" FontWeight="Medium" Height="18"/>
                            <TextBlock Text="{DynamicResource L_LanguageHelp}" Style="{StaticResource Muted}" Height="16" Margin="0,3,0,0"/>
                        </StackPanel>
                        <ListBox x:Name="LanguagePicker"
                                 Style="{StaticResource Segmented}"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center"
                                 AutomationProperties.Name="{DynamicResource L_Language}"
                                 SelectionChanged="Language_SelectionChanged"/>
                    </Grid>
                </Border>

                <!-- The title and description are the switch's label, as a <label for> is in
                     the artboard: clicking them flips it. -->
                <Border Height="81" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                    <Grid>
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Background="Transparent"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="StartupLabel_MouseLeftButtonUp">
                            <TextBlock Text="{DynamicResource L_OpenOnStartup}" FontSize="14" FontWeight="Medium" Height="18"/>
                            <TextBlock Text="{DynamicResource L_OpenOnStartupHelp}" Style="{StaticResource Muted}" Height="16" Margin="0,3,0,0"/>
                        </StackPanel>
                        <ToggleButton x:Name="StartupSwitch"
                                      Style="{StaticResource Switch}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="{DynamicResource L_OpenOnStartup}"
                                      AutomationProperties.HelpText="{DynamicResource L_OpenOnStartupHelp}"
                                      Checked="Startup_Changed"
                                      Unchecked="Startup_Changed"/>
                    </Grid>
                </Border>

                <Border Height="82" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1">
                    <Grid>
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Background="Transparent"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="KeepOnTopLabel_MouseLeftButtonUp">
                            <TextBlock Text="{DynamicResource L_AlwaysVisible}" FontSize="14" FontWeight="Medium" Height="18"/>
                            <TextBlock Text="{DynamicResource L_AlwaysVisibleHelp}" Style="{StaticResource Muted}" Height="16" Margin="0,3,0,0"/>
                        </StackPanel>
                        <ToggleButton x:Name="KeepOnTopSwitch"
                                      Style="{StaticResource Switch}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="{DynamicResource L_AlwaysVisible}"
                                      AutomationProperties.HelpText="{DynamicResource L_AlwaysVisibleHelp}"
                                      Checked="KeepOnTop_Changed"
                                      Unchecked="KeepOnTop_Changed"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- "Sidequest 0.1", 11 in Text2, 20 off the bottom as the artboard's line box
                 puts it (its text sits 22 up). -->
            <TextBlock x:Name="VersionText"
                       Grid.Row="2"
                       FontSize="11"
                       Foreground="{DynamicResource Text2}"
                       Height="14"
                       Margin="40,0,40,22"/>
        </Grid>
    </Border>
</Window>
