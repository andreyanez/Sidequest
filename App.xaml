<Application x:Class="Sidequest.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Slot 0 is the active theme, slot 1 the active language. ThemeService and
                 LanguageService replace them by index at runtime, so colours and strings
                 are referenced with DynamicResource throughout, and anything appended
                 after them must never be swapped - icons are theme-independent geometry
                 and take their colour from the ambient Foreground. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml"/>
                <ResourceDictionary Source="Strings/English.xaml"/>
                <ResourceDictionary Source="Icons/Icons.xaml"/>
                <!-- After Icons: its styles reach the geometry with StaticResource. -->
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Declared here, at the root, because a relative font location resolves
                 against the file that declares it: "./Fonts/" from Themes/Controls.xaml
                 would look in Themes/Fonts/. Popups (the "⋯" menu, tooltips) are outside
                 every window's tree and inherit nothing, so they reach for this directly. -->
            <FontFamily x:Key="AppFont">./Fonts/#DM Sans, Segoe UI</FontFamily>

            <!-- Text defaults are set on the window as inherited properties rather than
                 as an implicit TextBlock style. An implicit style would also apply to the
                 TextBlock that ContentPresenter generates for a button's string content,
                 and a style setter beats inheritance, which painted the primary button's
                 Inv label in the page's text colour.

                 Keyed, not implicit: an implicit style matches on the exact type, so
                 TargetType="Window" would never apply to MainWindow and friends.
                 Every window must set Style="{StaticResource AppWindow}" explicitly. -->
            <Style x:Key="AppWindow" TargetType="Window">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Text}"/>
                <!-- 4.1: one family throughout, Segoe UI only as fallback. The "#DM Sans"
                     form asks for the typographic family: Windows caps a font family at
                     four faces, so Medium and SemiBold report themselves as separate
                     Win32 families, and only this form gathers all four weights. -->
                <Setter Property="TextElement.FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="TextElement.FontSize" Value="13"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <!-- Chrome snaps every box to whole pixels when it paints. Without this,
                     anything below a line height like FnMain's 25.3 lands on a fraction of
                     a pixel, and a 1px border smears across two rows. -->
                <Setter Property="UseLayoutRounding" Value="True"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
