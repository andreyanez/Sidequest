<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 4.2's tokens, named as the spec names them so the two can be read side by side.
         Every key here must also exist in Dark.xaml (ResourceParityTests checks), and they
         are referenced with DynamicResource so a theme swap repaints open windows.

         A Sidequest's own colour is not here: it depends on two axes, its theme and this
         one, so SidequestPalette resolves it in code. -->
    <SolidColorBrush x:Key="Bg"      Color="#F6F6F4"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Hover"   Color="#ECECE8"/>
    <SolidColorBrush x:Key="Line"    Color="#E2E2DE"/>
    <SolidColorBrush x:Key="Line2"   Color="#C4C4BE"/>
    <SolidColorBrush x:Key="Text"    Color="#17181A"/>
    <SolidColorBrush x:Key="Text2"   Color="#5B5F68"/>
    <SolidColorBrush x:Key="Inv"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Canvas"  Color="#EFEFEC"/>

</ResourceDictionary>
