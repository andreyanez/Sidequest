<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Mirror of Light.xaml. Accent is lightened: the light-theme blue does not carry
         enough contrast against a dark background. -->

    <SolidColorBrush x:Key="PageBrush"        Color="#1B1D21"/>
    <SolidColorBrush x:Key="CardBrush"        Color="#26282D"/>
    <SolidColorBrush x:Key="InputBrush"       Color="#2E3136"/>
    <SolidColorBrush x:Key="BorderBrush"      Color="#3A3D44"/>
    <SolidColorBrush x:Key="CheckBorderBrush" Color="#565A62"/>
    <SolidColorBrush x:Key="TextBrush"        Color="#E8EAED"/>
    <SolidColorBrush x:Key="MutedBrush"       Color="#9AA0A6"/>
    <SolidColorBrush x:Key="AccentBrush"      Color="#4C8DFF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6BA1FF"/>
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#32353B"/>
    <SolidColorBrush x:Key="DangerBrush"      Color="#E5484D"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#F06065"/>
    <SolidColorBrush x:Key="DropTargetBrush"  Color="#2A3A55"/>

    <SolidColorBrush x:Key="ScrollThumbBrush"  Color="#4A4E56"/>

</ResourceDictionary>
