<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:Sidequest.Views">

    <!-- Sidequest's controls, per 4.1 and 4.4. Where a type has one look - CheckBox,
         TextBox, ScrollBar, ContextMenu, ToolTip - the style is implicit. Where it has
         several - the button kinds, the text styles - each is keyed and named for what it
         is, and a view asks for it by name.

         Not implemented: the letter-spacing 4.1 asks for (-0.02em on 22/700, +0.06em on
         section labels). WPF has no such property on TextBlock and the workarounds all
         cost more than the effect is worth. -->

    <!-- Pills (4.4) are half their height round; see PillRadiusConverter for why
         the artboards' 999 cannot be copied as it is. -->
    <views:PillRadiusConverter x:Key="PillRadius"/>

    <!-- ============ Typography (4.1) ============ -->

    <Style x:Key="Heading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="ItemText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
    </Style>

    <!-- 11/600 uppercase. The spec also wants +0.06em tracking here; see the note above. -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
    </Style>

    <Style x:Key="AppName" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}"/>

    <!-- ============ Focus rings ============ ================================
         4.4 gives the checkbox a 2px Text ring; every other control uses the same ring,
         shaped to its own corners, instead of WPF's dotted rectangle. Drawn 1px clear
         of the control, as CheckBox already does. Keyboard focus only - WPF shows
         focus visuals for keyboard navigation, never for a click. -->
    <Style x:Key="Focus.Pill">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" BorderThickness="2"
                            BorderBrush="{DynamicResource Text}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Focus.R8">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="11" BorderThickness="2"
                            BorderBrush="{DynamicResource Text}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Focus.R12">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="15" BorderThickness="2"
                            BorderBrush="{DynamicResource Text}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Focus.R10">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="13" BorderThickness="2"
                            BorderBrush="{DynamicResource Text}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A row inside a list box, whose corners are the list's: the ring sits just inside
         the row rather than 3px out, where the list would cut it off. -->
    <Style x:Key="Focus.Inset">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="1" CornerRadius="8" BorderThickness="2"
                            BorderBrush="{DynamicResource Text}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Buttons (4.4) ============ -->

    <!-- 28x28, radius 8. Text2 at rest, Text on hover, per 4.3. -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.R8}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The drag grip (4.4, D8): 18x32 and radius 10, its six dots in Text2. A Thumb, which
         takes the pointer for the whole drag; focusable, since Alt+Up and Alt+Down move its
         card from the keyboard (5.1). Its place is always kept; the cards show it on hover
         and on keyboard focus. Windows has no grab cursor, so it takes the one for moving
         up and down. -->
    <Style x:Key="Grip" TargetType="Thumb">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="IsTabStop" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
        <Setter Property="Cursor" Value="SizeNS"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.R10}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent" CornerRadius="10">
                        <Path Data="{StaticResource Icon.Grip}"
                              Fill="{TemplateBinding Foreground}"
                              Width="10"
                              Height="16"
                              Stretch="None"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A rename's check (5.1, 5.6), in the Sidequest's colour, which comes from the row
         it sits in. A setter rather than a local value, so hover still takes it to Text. -->
    <Style x:Key="SaveNameButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Foreground" Value="{Binding ThemeBrush}"/>
    </Style>

    <!-- The panel footer's gear: the same button at 36, and round, as FnMain draws it. -->
    <Style x:Key="RoundIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Pill}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The pin reads as active with a Hover fill and Text icon, so it needs a toggle. -->
    <Style x:Key="IconToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.R8}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pill 36, filled with Text, label in Inv. At most one per screen (4.4). -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource Inv}"/>
        <Setter Property="Background" Value="{DynamicResource Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Pill}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <!-- 5.5's Crear is disabled until the name has text. No artboard
                             shows the state, so it only dims. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pill 34, Surface with a Line2 border; the border goes to Text on hover. The fill
         can be set, for FnSidequestNuevo's Cancelar, which lets its form's tint through. -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Pill}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Line2}"
                            BorderThickness="1"
                            CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The sub-panel title bar's "‹ Panel principal". Measured on FnSidequests: 28 high,
         padding 4 left and 8 right, radius 8, 12/400 in Text2, a 4px gap after the
         chevron. Hover as .ib: Hover fill, Text. -->
    <Style x:Key="BackLink" TargetType="Button">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="4,0,8,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.R8}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The Sidequest chip on an objective card (4.4, 5.1): click opens the Sidequest.
         FnMainOverflowB draws it 20 high with its border, padding 0 8. It has no hover
         state - its inline colour outranks a:hover - so only the cursor says it is
         clickable. The text colour is the Sidequest's, set per card. -->
    <Style x:Key="Chip" TargetType="Button">
        <Setter Property="Height" Value="20"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Pill}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A Sidequest in the list (4.4, 5.4), compact as D9 chose: radius 10. Tint and
         border are the Sidequest's own, so the list sets Background and BorderBrush per
         button; hover takes the border to Text, as the artboards' .cta:hover does. The
         content - name, counter, progress - comes from the list's item template. -->
    <Style x:Key="SidequestButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.R10}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- The tint runs under the border, as CSS paints a background, so the
                         translucent border blends with the tint rather than with the page
                         behind: a WPF Border fills only inside its edge. -->
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="10"/>
                        <Border x:Name="Bd"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 4.4's dashed button. WPF borders cannot dash, so the outline is a Rectangle.
         Measured on the artboards, Chrome draws both dashes as 3 on, 2 off. -->
    <!-- "+ Nuevo Sidequest" (5.4): 50 as rendered (48 content-box plus the border),
         radius 12, 1px, 14/500. The rectangle's radius is taken at the stroke's centre. -->
    <Style x:Key="DashedButton" TargetType="Button">
        <Setter Property="Height" Value="50"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.R12}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12"/>
                        <Rectangle Stroke="{DynamicResource Line2}" StrokeThickness="1"
                                   StrokeDashArray="3 2" RadiusX="11.5" RadiusY="11.5"
                                   SnapsToDevicePixels="True"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "+ Añadir item" (5.6): FnSidequest draws this one as a 44px pill with 13/700 text
         and a 1.5px dash, which Chrome draws 1px wide (see CheckBox), 3 on and 2 off. -->
    <Style x:Key="DashedPillButton" TargetType="Button" BasedOn="{StaticResource DashedButton}">
        <Setter Property="Height" Value="44"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Pill}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}"/>
                        <Rectangle Stroke="{DynamicResource Line2}" StrokeThickness="1"
                                   StrokeDashArray="3 2" RadiusX="21.5" RadiusY="21.5"
                                   SnapsToDevicePixels="True"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "Enviar objetivo" (4.4, 5.6). A 30px pill - FnSidequest draws it as a <button>,
         which is border-box, so the border sits inside the 30: 1px, as Chrome draws its
         1.5 at 100 % (see CheckBox). Border C @ 55% and text in C are the Sidequest's, set
         per row; hover takes the border to Text. -->
    <Style x:Key="SendButton" TargetType="Button">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Pill}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Notas tab (5.6) ============ ==============================
         An objective's detail in 0.1 (5.3), a Sidequest's Notas tab since 0.2.

         Text that opens something, with no chrome: the base of a file row. -->
    <Style x:Key="TextButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.R8}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A linked file, the whole 42px row: click opens it (5.6). FnSidequestNotas gives it no
         hover state, so only the cursor says so. The separator under it is the list's. -->
    <Style x:Key="FileRowButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
        <Setter Property="Height" Value="42"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Inset}"/>
    </Style>

    <!-- "+ Vincular archivo", the last row of the list: 42 high, 12 in, 13px in Text2; hover
         as .ib, a Hover fill and Text. Disabled at five files (5.6). -->
    <Style x:Key="ListActionButton" TargetType="Button">
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Inset}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- An image cell: the thumbnail fills a 66px box, radius 10, with a Line border (5.6).
         The thumbnail arrives as Background; content is only shown when there is none,
         for an image whose copy has gone missing. -->
    <Style x:Key="ImageCellButton" TargetType="Button">
        <Setter Property="Height" Value="66"/>
        <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.R10}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="1"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border CornerRadius="9" Background="{TemplateBinding Background}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The "+" cell: FnSidequestNotas's 1px dashed Line2 at radius 10; hover as .ib. -->
    <Style x:Key="DashedCell" TargetType="Button">
        <Setter Property="Height" Value="66"/>
        <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.R10}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"/>
                        <Rectangle x:Name="Dash" Stroke="{DynamicResource Line2}" StrokeThickness="1"
                                   StrokeDashArray="3 2" RadiusX="9.5" RadiusY="9.5" SnapsToDevicePixels="True"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        </Trigger>
                        <!-- An image dragged over the tab (5.6): the cell it will land in. -->
                        <Trigger Property="Tag" Value="DropTarget">
                            <Setter TargetName="Dash" Property="Stroke" Value="{DynamicResource Text}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "Quitar" on a thumbnail, shown on hover or focus. It sits on the picture itself, so
         it carries its own solid Surface disc to stay legible on any image. -->
    <Style x:Key="OverlayButton" TargetType="Button">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Pill}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Line2}"
                            BorderThickness="1"
                            CornerRadius="11">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Checkbox (4.4) ============ ============================
         18px, radius 6, 1.5px Line2. When checked it fills with the Sidequest's own
         colour, which differs per row - so the fill comes from Background rather than a
         fixed brush, and each card supplies it. -->
    <Style TargetType="CheckBox">
        <Setter Property="Background" Value="{DynamicResource Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" Width="18" Height="18">
                        <!-- Circle, not the 6px 4.3 asks for: every checkbox in the
                             artboards sets border-radius 10px on an 18px box, which CSS
                             clamps to 9 - a circle. The artboard is the stated authority,
                             so it wins, but the two do disagree.

                             1px, not the 1.5 of 4.4 and the artboards: Chrome floors a
                             border to whole device pixels, so at 100 % it draws 1.5 as 1,
                             where layout rounding would make it 2 here. 1 matches Chrome
                             from 100 to 175 %. The same goes for every 1.5px border. -->
                        <Border x:Name="Box"
                                CornerRadius="9"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource Line2}"
                                Background="Transparent"
                                SnapsToDevicePixels="True"/>
                        <!-- The artboard's tick is a 12x12 svg on a 16-unit viewBox, so its
                             2.25 stroke renders at 0.75 scale = 1.69 px, and the glyph fills
                             only part of the 12. Stretching the Path to the box instead made
                             it both larger and heavier, so the svg is reproduced exactly: a
                             16x16 Grid gives the Viewbox the same unit square to scale from,
                             which scales geometry and stroke together the way SVG does. -->
                        <Viewbox x:Name="Tick"
                                 Width="12"
                                 Height="12"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Visibility="Collapsed">
                            <Grid Width="16" Height="16">
                                <Path Data="{StaticResource Icon.Check}"
                                      Stroke="{DynamicResource Inv}"
                                      StrokeThickness="2.25"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stretch="None"/>
                            </Grid>
                        </Viewbox>
                        <Border x:Name="FocusRing"
                                CornerRadius="12"
                                BorderThickness="2"
                                BorderBrush="{DynamicResource Text}"
                                Margin="-3"
                                Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Text2}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Text fields (4.4) ============ ==========================
         Surface, border Line, radius 10, padding 12, focus border Text - which is
         FnSidequestNotas's notes field exactly.

         FnSidequestNuevo's name field is deliberately NOT this: inside a theme-tinted
         card it drops to Bg with a border in the Sidequest's colour, so it still reads
         as a well against the tint. Phase 3 sets Background and BorderBrush locally on
         top of this style rather than forking it. -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Text2}"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="AllowDrop" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                        <!-- VerticalScrollBarVisibility is bound through so a multi-line
                             field is not clipped to one line.

                             No Margin="{TemplateBinding Padding}" here, in this or any
                             TextBox template: TextBox applies its own Padding to the text
                             inside PART_ContentHost, so binding it as well indents the text
                             twice. Measured on 5.5's name field, it put the text 26px in. -->
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                      Focusable="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- IsKeyboardFocusWithin, not IsFocused: the caret lives in the
                             inner ScrollViewer, so IsFocused misses a click into the text. -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Text}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Line2}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A single-line field at a fixed height with its text centred: FnSidequestNuevo's
         name field is a border-box <input>, 40 high, 12 in from its border. -->
    <Style x:Key="TextBox.Line" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Height" Value="40"/>
        <!-- 10, not the artboard's 12: TextBox insets its text a further 2px of its own. -->
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Text}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Line2}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The name field in 5.5's form. Inside the theme-tinted card it drops to Bg so it
         still reads as a well, and focus takes its border to the Sidequest's colour rather
         than Text (4.4). That colour differs per Sidequest, so the form passes it in as
         Tag: at rest the border is Line like any field, and Tag is what focus shows. -->
    <Style x:Key="TextBox.Themed" TargetType="TextBox" BasedOn="{StaticResource TextBox.Line}">
        <Setter Property="Background" Value="{DynamicResource Bg}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Line2}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- In-place rename of a Sidequest's title (5.6). No artboard shows it, so it keeps the
         title exactly where it was and only adds an underline in the Sidequest's colour to
         say it is editable. Font and colours are set by the view to match the title. -->
    <Style x:Key="InlineEdit" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,1.5"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      Focusable="False"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A field with no chrome at all, which sits inside something else's: the add-item
         pill (5.6) and a row being renamed (5.1, 5.6). TextBox insets its text 2px of its
         own, which the views take off their margins. -->
    <Style x:Key="BareTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Text2}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  Background="{TemplateBinding Background}"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden"
                                  Focusable="False"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 5.6's notes: one plain-text field whose web addresses show as links in the
         Sidequest's colour. A RichTextBox rather than a TextBox, for two reasons: its
         document can carry FnSidequestNotas's 1.55 line height, which a TextBox cannot,
         and its links stay live while it is being edited. The view builds the document;
         this is the frame: Surface, a Line border that goes to Text on focus, radius 10, a
         fixed 176, border-box. As with TextBox, Padding is applied by the control itself. The
         document's PagePadding must be 0 as well, and set on the document the control
         already has: a RichTextBox gives any document assigned to it a 5px page padding
         each side, overriding whatever the document said. -->
    <Style x:Key="NotesBox" TargetType="RichTextBox">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Text2}"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="176"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="IsDocumentEnabled" Value="True"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RichTextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                      Focusable="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Text}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Line2}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Theme picker (5.5) ============ =========================
         A ListBox, so single selection, arrow keys and a single tab stop come for free,
         and a screen reader hears a list with the chosen theme selected. 28px swatches,
         radius 9, 10 apart, as FnSidequestNuevo draws them since 0.3 (5.5 still says 30
         and 10); the selected one is ringed 2px in Text at 2px, which is its outline, and
         the row's 2px padding is the room it needs. Keyboard focus adds a second ring
         outside it, since the first only says which one is chosen. Each item supplies
         Brush and Label. -->
    <Style x:Key="Focus.Swatch">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-7" CornerRadius="16" BorderThickness="2"
                            BorderBrush="{DynamicResource Text2}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Swatch" TargetType="ListBoxItem">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Swatch}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border CornerRadius="9" Background="{Binding Brush}"/>
                        <Border x:Name="Ring"
                                Margin="-4"
                                CornerRadius="13"
                                BorderThickness="2"
                                BorderBrush="{DynamicResource Text}"
                                Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SwatchPicker" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Swatch}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Tabs (4.4, 5.6) ============ ==============================
         A Sidequest's Items and Notas, measured on FnSidequest: a Surface well with a Line
         border, radius 12 and 3 of padding, 10 under the band and 12 in from the sides;
         two tabs of equal width, 32 high, radius 9, 2 apart. The chosen one is filled Text
         with 13/700 in Inv; the other is 13/500 in Text2 and goes to Text on hover, with
         no fill. A TabControl, so a screen reader hears tabs and Ctrl+Tab works from
         inside either. -->
    <Style x:Key="Focus.R9">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="12" BorderThickness="2"
                            BorderBrush="{DynamicResource Text}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidequestTab" TargetType="TabItem">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.R9}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <!-- Font and colour go on the header alone: a TabItem hands what is set
                         on it down to its content, which here is the rest of the screen. -->
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="9">
                        <ContentPresenter x:Name="Header"
                                          ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.FontSize="13"
                                          TextElement.FontWeight="Medium"
                                          TextElement.Foreground="{DynamicResource Text2}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Header" Property="TextElement.Foreground" Value="{DynamicResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Text}"/>
                            <Setter TargetName="Header" Property="TextElement.Foreground" Value="{DynamicResource Inv}"/>
                            <Setter TargetName="Header" Property="TextElement.FontWeight" Value="Bold"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- Only the chosen tab is a tab stop. A tab that takes focus takes the selection
             with it, so Tab passing through the other would switch to it; the arrow keys
             move between them instead (SidequestTabControl). -->
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="False">
                <Setter Property="IsTabStop" Value="False"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The tabs above, and below them the chosen tab's content, which takes the rest of
         the view. -->
    <Style x:Key="SidequestTabs" TargetType="TabControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Margin="12,10,12,0"
                                Padding="3"
                                CornerRadius="12"
                                Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource Line}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <!-- Halves 2 apart: each tab keeps 1 clear on either side, and
                                 the panel reaches 1 past the padding to make up the ends. -->
                            <UniformGrid Rows="1" Margin="-1,0" IsItemsHost="True"/>
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost"
                                          Grid.Row="1"
                                          ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Settings (5.8) ============ ==============================

         The segmented control, as a ListBox for the same reasons as the theme picker:
         single selection, arrow keys, one tab stop, and a screen reader hears a list with
         its choice selected. Measured on FnAjustes: a Surface well with a Line border,
         radius 12 and 3 of padding; options 30 high, 16 in, 2 apart, radius 5 - not the
         pill 4.4 would suggest, one more of the artboards' disagreements on buttons. The
         chosen one is filled Text with 13/600 in Inv; the rest are Text2, and take .ib's
         hover. Choosing applies at once, as 5.8 asks, so the arrow keys preview for free. -->
    <Style x:Key="Focus.R5">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="8" BorderThickness="2"
                            BorderBrush="{DynamicResource Text}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Segment" TargetType="ListBoxItem">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Margin" Value="2,0,0,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.R5}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Text}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Inv}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Segmented" TargetType="ListBox">
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Segment}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <!-- Each option carries its 2px gap on the left; the panel cancels the first. -->
                    <StackPanel Orientation="Horizontal" Margin="-2,0,0,0"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="3"
                            SnapsToDevicePixels="True">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The switch (4.4): 40x24, a Surface track with a Line2 border and a 16px Text2 knob
         3 in; on, the track fills with Text and the knob, now Inv, moves 16 right. Measured
         on FnAjustes, where both are on. -->
    <Style x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Pill}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track"
                            Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Line2}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="3"
                            SnapsToDevicePixels="True">
                        <Ellipse x:Name="Knob"
                                 Width="16"
                                 Height="16"
                                 HorizontalAlignment="Left"
                                 Fill="{DynamicResource Text2}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Text}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Text}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Inv}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Tooltips ============ ====================================
         The icon buttons' names, and an objective's whole title when its card cuts it
         (5.1, TitleTip). WPF shows a tooltip on keyboard focus as well as hover, in fixed
         light chrome that ignores the theme - glaring on the dark panel. FnMainOverflowB
         draws the title's: Hover under a Line2 border, radius 8, padding 7 and 10, 12/17
         text wrapping at 280 with the padding, and a shadow 6 down, black at 45 % - CSS's
         blur of 18 is a Gaussian of sigma 9, about 27 of WPF's BlurRadius. 5.1 has it use
         the implicit style, so every tooltip takes that look. The box's margin is room for
         the shadow, which TitleTip's placement allows for. Implicit, so every
         ToolTip="..." gets it; a popup inherits nothing, so the font is set here. -->
    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextBlock.LineHeight" Value="17"/>
        <Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Margin="18,12,18,24"
                            MaxWidth="280"
                            Background="{DynamicResource Hover}"
                            BorderBrush="{DynamicResource Line2}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,7">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="27" ShadowDepth="6" Direction="270" Opacity="0.45" Color="#000000"/>
                        </Border.Effect>
                        <!-- 1 higher than its place: WPF sets the baseline of a 17 line a
                             fraction lower than CSS, which here rounds to a whole pixel. -->
                        <ContentPresenter Margin="0,-1,0,1">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Menus ============ =======================================
         5.6's "⋯" menu, and the Cut/Copy/Paste menu of every text field, which would
         otherwise come up in WPF's light chrome. A popup is not in its window's visual
         tree, so nothing is inherited: font, size and colours are all set here. The
         margin is room for the shadow; the "⋯" menu's placement accounts for it. No
         artboard shows a menu, so it is held to 4.2's tokens and 4.3's radii.

         Entries and separators are styled inside it, so they reach only menu items. -->
    <Style TargetType="ContextMenu">
        <Style.Resources>
            <Style TargetType="MenuItem">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Highlight follows both the pointer and the arrow keys, so
                                     it doubles as the keyboard focus indicator. -->
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                                </Trigger>
                                <!-- A text field's Cut or Paste with nothing to act on. -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Keyed, not implicit: a menu hands its separators this style by resource
                 reference, which outranks an implicit one. -->
            <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border Height="1" Margin="6,4" Background="{DynamicResource Line}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>

        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="10,2,10,14"
                            Padding="4"
                            MinWidth="176"
                            CornerRadius="10"
                            Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Line2}"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.28" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Completed item (5.6) ============ =======================
         No box: FnSidequest's bare 14px tick in the Sidequest's colour, which arrives as
         Background the way CheckBox takes its fill. The svg is 14px on a 16-unit
         viewBox, so its 2.5 stroke lands at 2.19 - reproduced with the same Viewbox trick.
         Only clickable where 5.6 lets Done be edited; the view disables it otherwise. -->
    <Style x:Key="DoneCheck" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="14" Height="14" Background="Transparent">
                        <Viewbox Width="14" Height="14">
                            <Grid Width="16" Height="16">
                                <Path Data="{StaticResource Icon.Check}"
                                      Stroke="{TemplateBinding Background}"
                                      StrokeThickness="2.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stretch="None"/>
                            </Grid>
                        </Viewbox>
                        <Border x:Name="FocusRing"
                                Margin="-5"
                                CornerRadius="12"
                                BorderThickness="2"
                                BorderBrush="{DynamicResource Text}"
                                Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Scrollbar ============ ==================================
         No artboard shows one - they are fixed-height mockups with nothing to scroll -
         so there is no reference to match and this is only held to 4.2's tokens.
         Deliberately slim and chromeless: no arrows, no track. Implicit, so it also
         reaches the scroll viewers inside text fields. -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <!-- The inset from the bar's edges: 3 across it and 2 along it, so the two
             orientations pass it swapped. -->
        <Setter Property="Padding" Value="3,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd"
                            Background="{DynamicResource Line2}"
                            CornerRadius="3"
                            Margin="{TemplateBinding Padding}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Text2}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Text2}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="MinWidth" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}"/>
                            </Track.Thumb>
                            <!-- Page buttons are required by Track but carry no chrome. -->
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- No screen scrolls sideways, but a text field that stops wrapping can. -->
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="MinHeight" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" Orientation="Horizontal">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" Padding="2,3"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                    </Track.DecreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ Scroll area (4.4) ============ ===========================
         The scrolling middle every compact screen has between its fixed header and
         footer (5), as FnSidequestsCompacto draws it: 36px fades over an edge with more
         past it, and a 4px thumb, radius 2, in a 6px track inset 4 from the ends and 3 from
         the right, shown whenever there is overflow rather than only on hover. All of it
         lies over the content, which keeps its width whether the list scrolls or not. -->
    <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width" Value="6"/>
        <Setter Property="MinWidth" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb IsTabStop="False" Margin="1,0" MinHeight="24">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{DynamicResource ScrollThumbBrush}" CornerRadius="2"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                        </Track.IncreaseRepeatButton>
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                        </Track.DecreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollArea" TargetType="ScrollViewer">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="views:ScrollCues.Track" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"/>

                        <!-- Bg over Bg's own colour: the mask does the fading, so the fill
                             can stay a DynamicResource and follow the theme. -->
                        <Rectangle x:Name="TopFade"
                                   Height="36"
                                   VerticalAlignment="Top"
                                   Fill="{DynamicResource Bg}"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF000000" Offset="0"/>
                                    <GradientStop Color="#00000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <Rectangle x:Name="BottomFade"
                                   Height="36"
                                   VerticalAlignment="Bottom"
                                   Fill="{DynamicResource Bg}"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#FF000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>

                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Style="{StaticResource ThinScrollBar}"
                                   HorizontalAlignment="Right"
                                   Margin="0,4,3,4"
                                   Minimum="0"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="views:ScrollCues.MoreAbove" Value="True">
                            <Setter TargetName="TopFade" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="views:ScrollCues.MoreBelow" Value="True">
                            <Setter TargetName="BottomFade" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
